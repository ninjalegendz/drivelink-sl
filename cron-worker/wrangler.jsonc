{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "drivelink-cron",
  "main": "worker.ts",
  "compatibility_date": "2025-11-01",

  // Two cadences (OPS-001): every 15 minutes for the time-sensitive booking
  // lifecycle (payment expiry, auto-complete, overdue alerts), plus daily at
  // 3 AM UTC for the heavy R2 orphan-storage sweep. worker.ts maps the cron
  // string that fired to ?task=frequent | ?task=daily.
  "triggers": {
    "crons": ["*/15 * * * *", "0 3 * * *"]
  },

  // TARGET_URL stays in code; CRON_SECRET is pushed via `wrangler secret put`.
  "vars": {
    "TARGET_URL": "https://drivelink.lk"
  },

  "observability": {
    "enabled": true
  }
}
