# Supabase — from project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL — set to your local tunnel for dev, Vercel domain for prod
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Didit identity verification — Business Console → API & Webhooks
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=

# WhatsApp Cloud API — Meta for Developers → WhatsApp app
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
