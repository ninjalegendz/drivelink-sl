# Supabase — from project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL — set to your local tunnel for dev, Vercel domain for prod
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ── Public site config (single source of truth — see src/lib/site-config.ts) ──
# Public-facing contact channels. Change here, updates across the whole app.
NEXT_PUBLIC_WHATSAPP_NUMBER=+94 70 659 4005
NEXT_PUBLIC_SUPPORT_EMAIL=support@drivelink.lk
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@drivelink.lk
NEXT_PUBLIC_SITE_DOMAIN=drivelink.lk

# Growth-phase switches (flip as the platform plan progresses).
# FREE_LAUNCH=true → zero platform/booking fee + "0% commission" framing.
# Set to false when monetization begins (plan Phase 4).
NEXT_PUBLIC_FREE_LAUNCH=true
NEXT_PUBLIC_SHOW_USD=true
NEXT_PUBLIC_LKR_PER_USD=300

# Didit identity verification — Business Console → API & Webhooks
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=

# WhatsApp via the self-hosted Baileys service (see whatsapp-service/).
# WHATSAPP_SERVICE_URL = the service's public HTTPS URL (e.g. https://wa.drivelink.lk)
# WHATSAPP_SERVICE_TOKEN = shared secret, must match the service's WA_SERVICE_TOKEN
WHATSAPP_SERVICE_URL=
WHATSAPP_SERVICE_TOKEN=

# ── PostHog (product analytics, session replay) ──────────────
# Project API key from PostHog > Settings > Project. It is a WRITE-ONLY key and
# ships in the browser bundle, so it is not a secret. Leaving it blank disables
# PostHog entirely; nothing else needs changing.
NEXT_PUBLIC_POSTHOG_KEY=
# US cloud, matching the project at us.posthog.com. For an EU project swap all
# three to the eu.i / eu-assets.i / eu pair - a project cannot move between the
# two clouds, so this must match wherever the project was created.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_ASSET_HOST=https://us-assets.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# ── Cloudinary (image resizing in front of R2) ───────────────
# Cloud name only. Fetch mode needs no key in the browser, and nothing is
# uploaded to Cloudinary: R2 stays the source of truth. Leave blank and images
# are served straight from R2 exactly as before.
# Requires: Cloudinary Settings > Security > allow "fetched URL" for your R2 /
# cdn.drivelink.lk domain, otherwise every fetch returns 403.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
