{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "drivelink-operations-monitor",
	"main": "worker.ts",
	"compatibility_date": "2025-11-01",
	// Five-minute independent checks. The account currently uses two cron slots
	// for the booking worker, leaving this safely within the five free slots.
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	"vars": {
		"TARGET_URL": "https://drivelink.lk",
		"ALERT_TO_EMAIL": "support@drivelink.lk"
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "MONITOR_STATE",
			"id": "ca6a20cf63ae431cbee033839becb965"
		}
	]
}